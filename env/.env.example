# Copy to .env.development (or .env.local) and adjust per environment.
# Vite loads variables from this env/ folder (see vite.config.js).

# Browser API base URL (use /api/v1 with dev proxy, or full URL for direct calls)
VITE_API_BASE_URL=/api/v1

# Dev proxy: Vite forwards /api/* to this backend (avoids CORS in npm run dev)
API_PROXY_TARGET=http://localhost:8080
